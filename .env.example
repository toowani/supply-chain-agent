# Copy to .env (never commit .env). Defaults need no .env at all (local Ollama).
# LLM backend (OpenAI-compatible). Local Ollama default — free, nothing leaves the machine.
SCA_LLM_BASE_URL=http://localhost:11434/v1
SCA_LLM_MODEL=gpt-oss:20b
# alt local model: SCA_LLM_MODEL=gemma4:12b
# 본선 (OpenAI dev env): SCA_LLM_BASE_URL=https://api.openai.com/v1, SCA_LLM_MODEL=<model>, SCA_LLM_API_KEY=sk-...
SCA_LLM_API_KEY=ollama

SCA_HTTP_USER_AGENT=supply-chain-agent-poc/0.1
